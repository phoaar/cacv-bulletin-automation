# Google Sheets Configuration
# The ID of the Google Sheet containing bulletin data (found in the URL)
SHEET_ID=your_google_sheet_id_here

# Path to your Google Service Account JSON key file
CREDENTIALS_PATH=./credentials/service-account.json

# Anthropic API Configuration
# Used for automated translation of Chinese content
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional: Override the translation model (e.g. claude-3-5-haiku-latest)
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Gmail Notification Settings
# Use a dedicated Gmail account or a personal one with an "App Password"
GMAIL_USER=your.gmail@gmail.com
# Create an App Password at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Application Settings
# Official CACV Bulletin URL (used in notifications and QR codes)
LIVE_URL=https://cacv.org.au/cacv-english-bulletin/
# Path to Chrome/Chromium executable (required for PDF generation in some environments)
# CHROME_PATH=/usr/bin/google-chrome-stable
# Default password for PDF protection if not specified in the sheet
# PDF_PASSWORD=cacv-bulletin

# WordPress Integration (REST API)
# The base URL of the WordPress site
WP_URL=https://cacv.org.au
# A WordPress user with 'edit_pages' capability
WP_USERNAME=bulletin-bot
# Create an Application Password in the user's WordPress profile settings
WP_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx-xxxx
# The numeric ID of the WordPress page to update
WP_PAGE_ID=123
